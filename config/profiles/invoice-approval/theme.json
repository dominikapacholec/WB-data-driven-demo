{
  "defaultMode": "light",
  "base": {
    "--wb-ds-colors-acc1-500": "#0f766e",
    "--wb-ds-colors-acc1-600": "#0b5f58",
    "--wb-ds-colors-acc1-400": "#2f9e94",
    "--wb-public-font-family": "\"Poppins\", system-ui, -apple-system, sans-serif",
    "--app-radius": "14px",
    "--wb-public-node-border-radius": "12px",
    "--wb-public-node-width": "17rem",
    "--wb-public-transition": "160ms cubic-bezier(0.2, 0, 0, 1)"
  },
  "light": {
    "--wb-ds-ui-bg-canvas": "#f0f0f0",
    "--wb-ds-ui-bg-base": "#ffffff",
    "--wb-ds-ui-bg-elevated": "#f4f7f7",
    "--wb-ds-ui-stroke-default": "#dde5e4",
    "--wb-ds-canvas-node-bg-primary-default": "#ffffff",
    "--wb-ds-canvas-node-bg-secondary-default": "#eef3f2",
    "--wb-ds-canvas-node-stroke-default": "#d3dedd",
    "--wb-ds-ui-text-default": "#0f1a19",
    "--wb-ds-ui-text-subtle-default": "#4b5b59",
    "--wb-ds-canvas-edge-stroke-default": "#93a8a5"
  },
  "dark": {
    "--wb-ds-ui-bg-canvas": "#0b1211",
    "--wb-ds-ui-bg-base": "#131c1b",
    "--wb-ds-ui-bg-elevated": "#1b2726",
    "--wb-ds-ui-stroke-default": "#263937",
    "--wb-ds-canvas-node-bg-primary-default": "#182321",
    "--wb-ds-canvas-node-bg-secondary-default": "#22302e",
    "--wb-ds-canvas-node-stroke-default": "#2b403d",
    "--wb-ds-ui-text-default": "#e8f1f0",
    "--wb-ds-ui-text-subtle-default": "#9db3b0",
    "--wb-ds-canvas-edge-stroke-default": "#4a625f"
  },
  "inspector": [
    {
      "label": "Brand",
      "controls": [
        { "token": "--wb-ds-colors-acc1-500", "label": "Brand", "kind": "color", "bucket": "base" },
        {
          "token": "--wb-ds-colors-acc1-600",
          "label": "Brand hover",
          "kind": "color",
          "bucket": "base"
        }
      ]
    },
    {
      "label": "Surfaces",
      "controls": [
        { "token": "--wb-ds-ui-bg-canvas", "label": "Canvas", "kind": "color", "bucket": "mode" },
        { "token": "--wb-ds-ui-bg-base", "label": "Panels", "kind": "color", "bucket": "mode" },
        {
          "token": "--wb-ds-canvas-node-bg-primary-default",
          "label": "Node fill",
          "kind": "color",
          "bucket": "mode"
        },
        {
          "token": "--wb-ds-canvas-node-stroke-default",
          "label": "Node border",
          "kind": "color",
          "bucket": "mode"
        },
        {
          "token": "--wb-ds-canvas-edge-stroke-default",
          "label": "Edges",
          "kind": "color",
          "bucket": "mode"
        },
        { "token": "--wb-ds-ui-text-default", "label": "Text", "kind": "color", "bucket": "mode" }
      ]
    },
    {
      "label": "Shape",
      "controls": [
        {
          "token": "--app-radius",
          "label": "Panel radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 28,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--wb-public-node-border-radius",
          "label": "Node radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 24,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--wb-public-node-width",
          "label": "Node width",
          "kind": "length",
          "unit": "rem",
          "min": 12,
          "max": 26,
          "step": 0.25,
          "bucket": "base"
        }
      ]
    },
    {
      "label": "Type & motion",
      "controls": [
        {
          "token": "--wb-public-font-family",
          "label": "Font",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "Poppins", "value": "\"Poppins\", system-ui, sans-serif" },
            { "label": "Inter", "value": "\"Inter\", system-ui, sans-serif" },
            { "label": "IBM Plex Mono", "value": "\"IBM Plex Mono\", ui-monospace, monospace" }
          ]
        },
        {
          "token": "--wb-public-transition",
          "label": "Motion",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "Instant", "value": "0s" },
            { "label": "Snappy", "value": "100ms ease-in" },
            { "label": "Smooth", "value": "160ms cubic-bezier(0.2, 0, 0, 1)" },
            { "label": "Lazy", "value": "420ms cubic-bezier(0.2, 0, 0, 1)" }
          ]
        }
      ]
    }
  ]
}
