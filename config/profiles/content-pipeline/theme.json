{
  "defaultMode": "dark",
  "base": {
    "--wb-ds-colors-acc1-500": "#b45309",
    "--wb-ds-colors-acc1-600": "#92400e",
    "--wb-ds-colors-acc1-400": "#d97706",
    "--wb-public-font-family": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace",
    "--app-radius": "14px",
    "--wb-public-node-border-radius": "0px",
    "--wb-public-node-width": "17rem",
    "--wb-public-transition": "0s"
  },
  "light": {
    "--wb-ds-ui-bg-canvas": "#fffdfa",
    "--wb-ds-ui-bg-base": "#ffffff",
    "--wb-ds-ui-bg-elevated": "#f0ebe2",
    "--wb-ds-ui-bg-inset": "#efe8dc",
    "--wb-ds-ui-stroke-default": "#e3dccf",
    "--wb-ds-canvas-node-bg-primary-default": "#ffffff",
    "--wb-ds-canvas-node-bg-secondary-default": "#f3eee5",
    "--wb-ds-canvas-node-stroke-default": "#d4c9b6",
    "--wb-ds-ui-text-default": "#1c1710",
    "--wb-ds-ui-text-subtle-default": "#5e5445",
    "--wb-ds-canvas-edge-stroke-default": "#a39580"
  },
  "dark": {
    "--wb-ds-ui-bg-canvas": "#0f0d0a",
    "--wb-ds-ui-bg-base": "#181511",
    "--wb-ds-ui-bg-elevated": "#221e18",
    "--wb-ds-ui-bg-inset": "#1f1b15",
    "--wb-ds-ui-stroke-default": "#332d24",
    "--wb-ds-canvas-node-bg-primary-default": "#1c1813",
    "--wb-ds-canvas-node-bg-secondary-default": "#27221a",
    "--wb-ds-canvas-node-stroke-default": "#3d3529",
    "--wb-ds-ui-text-default": "#f5efe6",
    "--wb-ds-ui-text-subtle-default": "#bfb3a1",
    "--wb-ds-canvas-edge-stroke-default": "#6e6252"
  },
  "inspector": [
    {
      "label": "Brand",
      "controls": [
        { "token": "--wb-ds-colors-acc1-500", "label": "Brand", "kind": "color", "bucket": "base" },
        {
          "token": "--wb-ds-colors-acc1-600",
          "label": "Brand hover",
          "kind": "color",
          "bucket": "base"
        }
      ]
    },
    {
      "label": "Surfaces",
      "controls": [
        { "token": "--wb-ds-ui-bg-canvas", "label": "Canvas", "kind": "color", "bucket": "mode" },
        { "token": "--wb-ds-ui-bg-base", "label": "Panels", "kind": "color", "bucket": "mode" },
        {
          "token": "--wb-ds-canvas-node-bg-primary-default",
          "label": "Node fill",
          "kind": "color",
          "bucket": "mode"
        },
        {
          "token": "--wb-ds-canvas-node-stroke-default",
          "label": "Node border",
          "kind": "color",
          "bucket": "mode"
        },
        {
          "token": "--wb-ds-canvas-edge-stroke-default",
          "label": "Edges",
          "kind": "color",
          "bucket": "mode"
        },
        { "token": "--wb-ds-ui-text-default", "label": "Text", "kind": "color", "bucket": "mode" }
      ]
    },
    {
      "label": "Shape",
      "controls": [
        {
          "token": "--app-radius",
          "label": "Panel radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 28,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--wb-public-node-border-radius",
          "label": "Node radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 24,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--wb-public-node-width",
          "label": "Node width",
          "kind": "length",
          "unit": "rem",
          "min": 12,
          "max": 26,
          "step": 0.25,
          "bucket": "base"
        }
      ]
    },
    {
      "label": "Type & motion",
      "controls": [
        {
          "token": "--wb-public-font-family",
          "label": "Font",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "JetBrains Mono", "value": "\"JetBrains Mono\", ui-monospace, monospace" },
            { "label": "IBM Plex Mono", "value": "\"IBM Plex Mono\", ui-monospace, monospace" },
            { "label": "Inter", "value": "\"Inter\", system-ui, sans-serif" },
            { "label": "Poppins", "value": "\"Poppins\", system-ui, sans-serif" }
          ]
        },
        {
          "token": "--wb-public-transition",
          "label": "Motion",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "Instant", "value": "0s" },
            { "label": "Snappy", "value": "100ms ease-in" },
            { "label": "Smooth", "value": "160ms cubic-bezier(0.2, 0, 0, 1)" },
            { "label": "Lazy", "value": "420ms cubic-bezier(0.2, 0, 0, 1)" }
          ]
        }
      ]
    }
  ]
}
