{
  "defaultMode": "dark",
  "base": {
    "--wb-public-font-family": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace",
    "--app-radius": "14px",
    "--wb-public-node-border-radius": "0px",
    "--wb-public-node-width": "17rem",
    "--wb-public-transition": "0s"
  },
  "light": {
    "--wb-ds-colors-acc1-500": "#c2410c",
    "--wb-ds-colors-acc1-600": "#9a3412",
    "--wb-ds-colors-acc1-400": "#ea580c",
    "--wb-ds-ui-bg-canvas": "#f7f7f5",
    "--wb-ds-ui-bg-base": "#ffffff",
    "--wb-ds-ui-bg-elevated": "#efeeeb",
    "--wb-ds-ui-bg-inset": "#ebe9e5",
    "--wb-ds-ui-stroke-default": "#e0ded9",
    "--wb-ds-canvas-node-bg-primary-default": "#ffffff",
    "--wb-ds-canvas-node-bg-secondary-default": "#f3f2ef",
    "--wb-ds-canvas-node-stroke-default": "#d6d3cd",
    "--wb-ds-ui-text-default": "#1c1b19",
    "--wb-ds-ui-text-subtle-default": "#57534e",
    "--wb-ds-canvas-edge-stroke-default": "#a29e97",
    "--wb-public-scroll-thumb-color": "#cfccc6",
    "--wb-ds-canvas-node-focus-ring-active": "#c2410c66"
  },
  "dark": {
    "--wb-ds-colors-acc1-500": "#d97706",
    "--wb-ds-colors-acc1-600": "#b45309",
    "--wb-ds-colors-acc1-400": "#f59e0b",
    "--wb-ds-ui-bg-canvas": "#0c1017",
    "--wb-ds-ui-bg-base": "#141a24",
    "--wb-ds-ui-bg-elevated": "#1c2330",
    "--wb-ds-ui-bg-inset": "#19202b",
    "--wb-ds-ui-stroke-default": "#2a3344",
    "--wb-ds-canvas-node-bg-primary-default": "#1f2633",
    "--wb-ds-canvas-node-bg-secondary-default": "#283142",
    "--wb-ds-canvas-node-stroke-default": "#384459",
    "--wb-ds-ui-text-default": "#eef1f6",
    "--wb-ds-ui-text-subtle-default": "#a9b3c4",
    "--wb-ds-canvas-edge-stroke-default": "#56637a",
    "--wb-public-scroll-thumb-color": "#3a465c",
    "--wb-ds-canvas-node-focus-ring-active": "#f59e0b66",
    "--xy-attribution-background-color": "transparent"
  },
  "inspector": [
    {
      "label": "Brand",
      "controls": [
        { "token": "--wb-ds-colors-acc1-500", "label": "Brand", "kind": "color", "bucket": "mode" },
        {
          "token": "--wb-ds-colors-acc1-600",
          "label": "Brand hover",
          "kind": "color",
          "bucket": "mode"
        }
      ]
    },
    {
      "label": "Surfaces",
      "controls": [
        { "token": "--wb-ds-ui-bg-canvas", "label": "Canvas", "kind": "color", "bucket": "mode" },
        { "token": "--wb-ds-ui-bg-base", "label": "Panels", "kind": "color", "bucket": "mode" },
        {
          "token": "--wb-ds-canvas-node-bg-primary-default",
          "label": "Node fill",
          "kind": "color",
          "bucket": "mode"
        },
        {
          "token": "--wb-ds-canvas-node-stroke-default",
          "label": "Node border",
          "kind": "color",
          "bucket": "mode"
        },
        {
          "token": "--wb-ds-canvas-edge-stroke-default",
          "label": "Edges",
          "kind": "color",
          "bucket": "mode"
        },
        { "token": "--wb-ds-ui-text-default", "label": "Text", "kind": "color", "bucket": "mode" }
      ]
    },
    {
      "label": "Shape",
      "controls": [
        {
          "token": "--app-radius",
          "label": "Panel radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 28,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--wb-public-node-border-radius",
          "label": "Node radius",
          "kind": "length",
          "unit": "px",
          "min": 0,
          "max": 24,
          "step": 1,
          "bucket": "base"
        },
        {
          "token": "--wb-public-node-width",
          "label": "Node width",
          "kind": "length",
          "unit": "rem",
          "min": 12,
          "max": 26,
          "step": 0.25,
          "bucket": "base"
        }
      ]
    },
    {
      "label": "Type & motion",
      "controls": [
        {
          "token": "--wb-public-font-family",
          "label": "Font",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "JetBrains Mono", "value": "\"JetBrains Mono\", ui-monospace, monospace" },
            { "label": "IBM Plex Mono", "value": "\"IBM Plex Mono\", ui-monospace, monospace" },
            { "label": "Inter", "value": "\"Inter\", system-ui, sans-serif" },
            { "label": "Poppins", "value": "\"Poppins\", system-ui, sans-serif" }
          ]
        },
        {
          "token": "--wb-public-transition",
          "label": "Motion",
          "kind": "choice",
          "bucket": "base",
          "options": [
            { "label": "Instant", "value": "0s" },
            { "label": "Snappy", "value": "100ms ease-in" },
            { "label": "Smooth", "value": "160ms cubic-bezier(0.2, 0, 0, 1)" },
            { "label": "Lazy", "value": "420ms cubic-bezier(0.2, 0, 0, 1)" }
          ]
        }
      ]
    }
  ]
}
