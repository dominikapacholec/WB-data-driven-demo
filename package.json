{
  "name": "wb-data-driven-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --pretty",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "file-lint": "ls-lint",
    "format": "prettier --write \"**/*.+(css|ts|tsx|json|md)\"",
    "check": "npm run lint && npm run typecheck && npm run file-lint"
  },
  "dependencies": {
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/react": "^3.8.0",
    "@workflowbuilder/sdk": "^3.0.0",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@ls-lint/ls-lint": "^2.2.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^5.4.0"
  }
}
